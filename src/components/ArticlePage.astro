---
import { render } from "astro:content";

import type { Document, Page, SpaceshipConfig, Tag, TreeData } from "astro-spaceship/types";
import Layout from "astro-spaceship/components/Layout/Layout.astro";
import RightSidebar from "astro-spaceship/components/RightSidebar/RightSidebar.astro";

import LeftSidebarNav from "./LeftSidebarNav.astro";
import { formatDate, readingMinutes } from "../utils/docs";

export type DocLink = {
  title: string;
  permalink: string;
};

export type Props = {
  document: Document;
  page: Page;
  tags: Tag[];
  tree: TreeData;
  config: SpaceshipConfig;
  prev?: DocLink;
  next?: DocLink;
};

const { document, page, tags, tree, config, prev, next } = Astro.props;
const { data } = document;

const { Content, headings } = await render(document as never);

const withHeadings = {
  ...document,
  rendered: {
    html: "",
    metadata: { headings },
  },
} as Document;

const published = formatDate(data.created);
const updated = formatDate(data.updated);
const minutes = readingMinutes(document.body);
const showUpdated = updated && updated !== published;
---

<Layout config={config} page={page} footer={null}>
  <LeftSidebarNav website={config} tree={tree} />
  <article class="article" data-pagefind-body>
    <section class="article-content">
      <h1 class="article-title">{data.title}</h1>

      {
        data.subtitle && <p class="article-subtitle">{data.subtitle}</p>
      }

      <div class="article-meta-line">
        {published && <time datetime={published}>{published}</time>}
        {showUpdated && <span class="meta-muted">更新于 {updated}</span>}
        <span class="meta-muted">约 {minutes} 分钟</span>
        <a class="meta-archive" href="/archive">归档</a>
      </div>

      {
        tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <a class="article-tag" href={`/tags/${encodeURIComponent(tag.data.name)}`}>
                {tag.data.name}
              </a>
            ))}
          </div>
        )
      }

      <div class="article-body">
        <Content />
      </div>

      {
        (prev || next) && (
          <nav class="article-pager" aria-label="上下篇">
            {prev ? (
              <a class="pager-item pager-prev" href={prev.permalink}>
                <span class="pager-label">← 上一篇</span>
                <span class="pager-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="pager-item pager-next" href={next.permalink}>
                <span class="pager-label">下一篇 →</span>
                <span class="pager-title">{next.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </section>
  </article>
  <RightSidebar
    config={config}
    document={withHeadings}
    showToC={headings.length > 0}
    showLinks={false}
    showGraph={false}
    showMap={false}
  />
</Layout>

<style>
  .article-meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.9rem;
    margin: 0.9rem 0 0.35rem;
    font-size: 0.82rem;
    color: var(--color-text-faint);
  }

  .article-meta-line time {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .meta-archive {
    color: var(--color-primary);
    text-decoration: none;
  }

  .meta-archive:hover {
    text-decoration: underline;
  }

  .article-tags {
    flex-direction: row !important;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.4rem;
  }

  .article-pager {
    display: flex;
    gap: 1rem;
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hr-border);
  }

  .article-pager > span {
    flex: 1;
  }

  .pager-item {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-hr-border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pager-item:hover {
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .pager-next {
    text-align: right;
  }

  .pager-label {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .pager-title {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-normal);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 640px) {
    .article-pager {
      flex-direction: column;
    }

    .pager-next {
      text-align: left;
    }
  }
</style>
